# Copy to .env and fill in as needed. Never commit .env.
# Reference values in config/glance.yml with ${VAR_NAME}.

# Example: point a monitor/bookmark at a private service
# HOMELAB_URL=http://192.168.1.10:3000

# Example: tokens for widgets that need auth (see docs/configuration.md)
# GITHUB_TOKEN=
# REDDIT_APP=
